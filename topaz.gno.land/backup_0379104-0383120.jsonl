{"tx":{"msg":[{"@type":"/vm.m_addpkg","creator":"g16m0r7rm7fv5hx0ekr7gvx8g4fr7eu08nzhk6gt","package":{"name":"ratelimit","path":"gno.land/p/g16m0r7rm7fv5hx0ekr7gvx8g4fr7eu08nzhk6gt/ratelimit","files":[{"name":"gnomod.toml","body":"module = \"gno.land/p/g16m0r7rm7fv5hx0ekr7gvx8g4fr7eu08nzhk6gt/ratelimit\"\ngno = \"0.9\"\n"},{"name":"ratelimit.gno","body":"// Package ratelimit provides a token-bucket rate limiter for use inside\n// gno.land realms. It holds no chain state itself -- the importing realm\n// owns a *TokenBucket (typically as a struct field or inside an avl.Tree\n// keyed by caller address) and passes in the current block height on\n// every check, since a pure package can't call chain/runtime itself.\npackage ratelimit\n\nimport (\n\t\"math/overflow\"\n)\n\n// TokenBucket implements the classic token-bucket algorithm. Tokens\n// refill linearly with block height and are capped at Capacity.\ntype TokenBucket struct {\n\tCapacity        int64\n\tRefillPerBlock  int64\n\tTokens          int64\n\tLastRefillBlock int64\n}\n\n// NewTokenBucket creates a bucket starting full (Tokens == capacity).\n// capacity and refillPerBlock must both be positive.\nfunc NewTokenBucket(capacity, refillPerBlock, nowBlock int64) *TokenBucket {\n\tif capacity \u003c= 0 {\n\t\tpanic(\"ratelimit: capacity must be positive\")\n\t}\n\tif refillPerBlock \u003c= 0 {\n\t\tpanic(\"ratelimit: refillPerBlock must be positive\")\n\t}\n\n\treturn \u0026TokenBucket{\n\t\tCapacity:        capacity,\n\t\tRefillPerBlock:  refillPerBlock,\n\t\tTokens:          capacity,\n\t\tLastRefillBlock: nowBlock,\n\t}\n}\n\n// refill tops up tokens based on elapsed blocks since the last refill,\n// capped at Capacity. If elapsed*rate would overflow int64 (e.g. the\n// bucket sat unused for a very long time with a high refill rate), that\n// is treated as \"more than enough to fill it\" and capped directly --\n// a long idle gap is normal behavior for a rate limiter, not a bug, so\n// this never panics on that account.\nfunc (b *TokenBucket) refill(nowBlock int64) {\n\tif nowBlock \u003c= b.LastRefillBlock {\n\t\treturn\n\t}\n\n\telapsed := nowBlock - b.LastRefillBlock\n\tadded, ok := overflow.Mul64(elapsed, b.RefillPerBlock)\n\tif !ok {\n\t\tb.Tokens = b.Capacity\n\t\tb.LastRefillBlock = nowBlock\n\t\treturn\n\t}\n\n\tnewTokens, ok := overflow.Add64(b.Tokens, added)\n\tif !ok || newTokens \u003e b.Capacity {\n\t\tnewTokens = b.Capacity\n\t}\n\n\tb.Tokens = newTokens\n\tb.LastRefillBlock = nowBlock\n}\n\n// Allow refills the bucket up to nowBlock, then attempts to spend cost\n// tokens. Returns true and deducts cost if there were enough tokens,\n// false (no deduction) otherwise.\nfunc (b *TokenBucket) Allow(nowBlock int64, cost int64) bool {\n\tif cost \u003c= 0 {\n\t\tpanic(\"ratelimit: cost must be positive\")\n\t}\n\n\tb.refill(nowBlock)\n\n\tif b.Tokens \u003c cost {\n\t\treturn false\n\t}\n\n\tb.Tokens -= cost\n\treturn true\n}\n\n// Peek refills the bucket up to nowBlock (mutating LastRefillBlock and\n// Tokens, same as Allow would) and returns the resulting token count,\n// without spending anything. Useful for a read-only \"how many do I have\n// right now\" view function.\nfunc (b *TokenBucket) Peek(nowBlock int64) int64 {\n\tb.refill(nowBlock)\n\treturn b.Tokens\n}\n"}],"type":{"@type":"/gno.MemPackageType","value":"MPUserAll"}},"send":"","max_deposit":""}],"fee":{"gas_wanted":"30000000","gas_fee":"1000000ugnot"},"signatures":[{"pub_key":{"@type":"/tm.PubKeySecp256k1","value":"AjNM8kyoIRAgmj227lxB4Fi4oYKxJ810GIcAFIIqDb28"},"signature":"ONuJatzCYkOrKhZKM/zNCw7Wqz9yLGGTAa4UMHK24BYobvRkH61l6hejvevQvubGfm32D0GWdUy+sh/Qhtwq+Q=="}],"memo":""},"metadata":{"timestamp":"1785711759"}}
{"tx":{"msg":[{"@type":"/vm.m_addpkg","creator":"g16m0r7rm7fv5hx0ekr7gvx8g4fr7eu08nzhk6gt","package":{"name":"merkle","path":"gno.land/p/g16m0r7rm7fv5hx0ekr7gvx8g4fr7eu08nzhk6gt/merkle","files":[{"name":"gnomod.toml","body":"module = \"gno.land/p/g16m0r7rm7fv5hx0ekr7gvx8g4fr7eu08nzhk6gt/merkle\"\ngno = \"0.9\"\n"},{"name":"merkle.gno","body":"// Package merkle provides merkle tree construction and proof\n// verification. Leaf and internal-node hashes use different domain\n// separation prefixes (0x00 vs 0x01) so a proof can never confuse a leaf\n// hash for an internal node hash or vice versa -- a classic merkle tree\n// forgery vector if left unguarded.\n//\n// Odd-sized levels promote the unpaired node unchanged to the next level\n// (rather than duplicating the last node), which avoids the known\n// duplicate-leaf ambiguity issue some naive merkle implementations have.\npackage merkle\n\nimport (\n\t\"crypto/sha256\"\n)\n\nconst (\n\tleafPrefix byte = 0x00\n\tnodePrefix byte = 0x01\n)\n\n// ProofStep is one step of an audit path: the sibling hash, and whether\n// that sibling belongs on the right (true) or left (false) when combined\n// with the running hash.\ntype ProofStep struct {\n\tHash           [32]byte\n\tIsRightSibling bool\n}\n\n// HashLeaf hashes raw leaf data with the leaf domain prefix. Callers\n// should always go through this rather than hashing data directly, or\n// the tree loses its leaf/node domain separation.\nfunc HashLeaf(data []byte) [32]byte {\n\tbuf := make([]byte, 0, len(data)+1)\n\tbuf = append(buf, leafPrefix)\n\tbuf = append(buf, data...)\n\treturn sha256.Sum256(buf)\n}\n\nfunc hashNode(left, right [32]byte) [32]byte {\n\tbuf := make([]byte, 0, 1+64)\n\tbuf = append(buf, nodePrefix)\n\tbuf = append(buf, left[:]...)\n\tbuf = append(buf, right[:]...)\n\treturn sha256.Sum256(buf)\n}\n\n// nextLevel pairs up consecutive nodes and hashes them together. An\n// unpaired trailing node (odd-sized level) is carried up unchanged --\n// deliberately NOT re-hashed or duplicated, since duplicating it would\n// reopen the classic duplicate-leaf forgery issue.\nfunc nextLevel(level [][32]byte) [][32]byte {\n\tnext := make([][32]byte, 0, (len(level)+1)/2)\n\tfor i := 0; i \u003c len(level); i += 2 {\n\t\tif i+1 \u003c len(level) {\n\t\t\tnext = append(next, hashNode(level[i], level[i+1]))\n\t\t} else {\n\t\t\tnext = append(next, level[i])\n\t\t}\n\t}\n\treturn next\n}\n\n// BuildRoot computes the merkle root from a list of already-leaf-hashed\n// values (see HashLeaf). Panics on an empty input -- there's no\n// meaningful root for zero leaves.\nfunc BuildRoot(leafHashes [][32]byte) [32]byte {\n\tif len(leafHashes) == 0 {\n\t\tpanic(\"merkle: cannot build a root from zero leaves\")\n\t}\n\n\tlevel := leafHashes\n\tfor len(level) \u003e 1 {\n\t\tlevel = nextLevel(level)\n\t}\n\treturn level[0]\n}\n\n// GenerateProof builds the audit path for the leaf at index. Panics if\n// index is out of range for the given leaf set.\nfunc GenerateProof(leafHashes [][32]byte, index int) []ProofStep {\n\tif len(leafHashes) == 0 {\n\t\tpanic(\"merkle: cannot generate a proof for zero leaves\")\n\t}\n\tif index \u003c 0 || index \u003e= len(leafHashes) {\n\t\tpanic(\"merkle: index out of range\")\n\t}\n\n\tvar proof []ProofStep\n\tlevel := leafHashes\n\tidx := index\n\n\tfor len(level) \u003e 1 {\n\t\tif idx%2 == 0 {\n\t\t\tif idx+1 \u003c len(level) {\n\t\t\t\tproof = append(proof, ProofStep{Hash: level[idx+1], IsRightSibling: true})\n\t\t\t}\n\t\t} else {\n\t\t\tproof = append(proof, ProofStep{Hash: level[idx-1], IsRightSibling: false})\n\t\t}\n\t\tlevel = nextLevel(level)\n\t\tidx = idx / 2\n\t}\n\n\treturn proof\n}\n\n// VerifyProof replays the audit path starting from leafHash and checks\n// whether it reconstructs root.\nfunc VerifyProof(leafHash [32]byte, proof []ProofStep, root [32]byte) bool {\n\tcurrent := leafHash\n\tfor _, step := range proof {\n\t\tif step.IsRightSibling {\n\t\t\tcurrent = hashNode(current, step.Hash)\n\t\t} else {\n\t\t\tcurrent = hashNode(step.Hash, current)\n\t\t}\n\t}\n\treturn current == root\n}\n"}],"type":{"@type":"/gno.MemPackageType","value":"MPUserAll"}},"send":"","max_deposit":""}],"fee":{"gas_wanted":"30000000","gas_fee":"1000000ugnot"},"signatures":[{"pub_key":{"@type":"/tm.PubKeySecp256k1","value":"AjNM8kyoIRAgmj227lxB4Fi4oYKxJ810GIcAFIIqDb28"},"signature":"sPC8wx1SiK60ClF+VHFf+Cv5C9A1th8ibPfxUlfTSdNnaafsawk+IlzFz+LKrlaAqOlhoVeOKVHwewyf8Lq8Og=="}],"memo":""},"metadata":{"timestamp":"1785712144"}}
