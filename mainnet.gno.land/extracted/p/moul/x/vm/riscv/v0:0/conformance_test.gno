// skipped names the two cases this machine cannot pass by design, with the
// reason, because silently dropping a conformance case is how a suite stops
// meaning anything.
var skipped = map[string]string{
	// FENCE.I exists to make writes to the instruction stream visible. This
	// machine predecodes its text and refuses stores into it, so there is no
	// instruction stream to make visible: self-modifying code is not
	// unimplemented here, it is excluded. See README, W xor X.
	"rv32ui-fence_i": "self-modifying code is refused by design",
}

func TestRISCVConformance(t *testing.T) {
	ran, skips := 0, 0
	for _, c := range conformanceCases {
		if why, ok := skipped[c.name]; ok {
			skips++
			t.Log(c.name + ": skipped, " + why)
			continue
		}
		m, err := NewMachine(Image(c.text), entry)
		uassert.NoError(t, err, c.name)
		if m == nil {
			continue
		}
		if len(c.data) > 0 {
			uassert.NoError(t, m.LoadData(conformanceDataAddr, Image(c.data)), c.name)
		}
		_, status := m.Step(vmkit.NewTestHost(), conformanceFuel)
		uassert.Equal(t, "halted", status.String(), c.name+": "+m.Trap())
		// The suite's convention: a0 is 0 on pass, and on failure it is the
		// failing case number shifted left with the low bit set.
		a0 := m.Registers()[10]
		uassert.Equal(t, uint64(0), uint64(a0),
			c.name+" failed at its case number "+itoa(int(a0>>1)))
		ran++
	}
	uassert.True(t, ran >= 45, "the conformance suite must actually have run")
	uassert.Equal(t, len(skipped), skips, "a skip must be declared, not discovered")
}

func itoa(n int) string {
	if n == 0 {
		return "0"
	}
	var b []byte
	for n > 0 {
		b = append([]byte{byte('0' + n%10)}, b...)
		n /= 10
	}
	return string(b)
}

// A conformance suite that passes a broken emulator is worse than none, so the
// harness is checked against a program built to fail, using the suite's own
// exit convention. Without this, a change that made every case report a0 == 0
// would turn the whole file green and look like progress.
//
// The suite was also checked the other way, by injecting faults into exec.gno
// and confirming it went red and named the case:
//
//   SRAI as a logical shift        -> rv32ui-srai and rv32ui-lui, case 3
//   REMU by zero returning 0       -> rv32um-remu, case 8
//
// Both are recorded here rather than left as something someone did once,
// because they are how you check this file still bites.
func TestConformanceHarnessDetectsAFailure(t *testing.T) {
	// The tail of RVTEST_FAIL for testnum 5: gp is shifted left and the low
	// bit set, so a0 is 11 and the reported case number is 5.
	fail := []uint32{
		addi(3, 0, 5),   // TESTNUM = 5
		addi(17, 0, 93), // a7 = exit
		addi(10, 0, 11), // a0 = (5 << 1) | 1
		ecall(),
	}
	m, err := NewMachine(Image(fail), entry)
	uassert.NoError(t, err)
	if m == nil {
		return
	}
	_, status := m.Step(vmkit.NewTestHost(), conformanceFuel)
	uassert.Equal(t, "halted", status.String())

	a0 := m.Registers()[10]
	uassert.False(t, a0 == 0, "a failing case must not look like a pass")
	uassert.Equal(t, uint64(11), uint64(a0))
	uassert.Equal(t, "5", itoa(int(a0>>1)), "the reported case number")
}

// And the pass side, so the convention is pinned from both directions.
func TestConformanceHarnessRecognizesAPass(t *testing.T) {
	pass := []uint32{
		addi(3, 0, 1),   // TESTNUM = 1
		addi(17, 0, 93), // a7 = exit
		addi(10, 0, 0),  // a0 = 0
		ecall(),
	}
	m, err := NewMachine(Image(pass), entry)
	uassert.NoError(t, err)
	if m == nil {
		return
	}
	_, status := m.Step(vmkit.NewTestHost(), conformanceFuel)
	uassert.Equal(t, "halted", status.String())
	uassert.Equal(t, uint64(0), uint64(m.Registers()[10]))
}
