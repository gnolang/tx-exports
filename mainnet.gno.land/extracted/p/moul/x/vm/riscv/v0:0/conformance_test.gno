package riscv

import (
	"testing"

	"gno.land/p/moul/x/vm/vmkit/v0"
	"gno.land/p/nt/uassert/v0"
)

// The official RISC-V conformance suite, built from
// github.com/riscv-software-src/riscv-tests at the rv32ui and rv32um targets.
//
// This is the only test here that a third party wrote. Everything in
// riscv_test.gno checks that the emulator agrees with its author's reading of
// the spec; this checks that it agrees with the people who wrote the spec.
//
// The suite's own environment (env/p) sets up mtvec, delegates traps and
// returns through mret, none of which exists on a hart with no CSRs and one
// privilege level. So these were built against a replacement riscv_test.h that
// keeps the parts of the contract the tests rely on and drops the machine-mode
// ceremony. Crucially the exit convention is the suite's own, unchanged: it
// already spells pass and fail as `li a7, 93; ecall`, which is this host's exit
// syscall, so a0 == 0 means pass and a0 == (testnum << 1) | 1 names the case
// that failed.
//
// Regenerating the corpus, the replacement header and the linker script:
// tools/riscv-guests/conformance.

// conformanceDataAddr is where the linker script puts .data, far above the
// text segment because the text is read-only here.
const conformanceDataAddr = 0x40000

// conformanceFuel bounds a runaway test. Every case in the suite finishes in
// well under this; a case that does not has failed in a way worth reporting as
// a timeout rather than hanging the run.
const conformanceFuel = 2000000

type conformanceCase struct {
	name string
	text []uint32
	data []uint32
}

var conformanceCases = []conformanceCase{
