package gns

// setupPreMint mints the initial GNS supply to fixed recipients at realm init.
//
// Generated by scripts/patch-gns-premint.sh from GNS_PRE_MINT. It replaces the
// upstream role-based recipient (rbac ADMIN) with the addresses listed below.
func setupPreMint(cur realm) {
	err := privateLedger.Mint("g1y7h659patawdy99mlufj9lp3t9cwpt8fq852zq", 50_000_000_000_000)
	if err != nil {
		panic(err.Error())
	}

	err = privateLedger.Mint("g1plxd74hnxyjvh309nfcndp53ypvv93yp5rd7dk", 50_000_000_000_000)
	if err != nil {
		panic(err.Error())
	}
}
