// Package crowdfunding implements the V0 supported crowdfunding realm:
// creators raise native ugnot until a deadline; campaigns that meet their
// target pay the creator, campaigns that don't refund contributors.
// 
// Creators raise native testnet GNOT until a deadline; successful campaigns pay creators and failed campaigns refund contributors.
// 
// Generated by generator/ from the "Community Crowdfunding" app-spec (schema_version 1.0, revision 1). Do not hand-edit generated output; change the spec and regenerate instead.
package crowdfunding

import (
	"chain"
	"chain/banker"
	"chain/runtime/unsafe"
	"strconv"
	"strings"
	"time"
	"unicode/utf8"

	"gno.land/p/nt/avl/v0"
	"gno.land/p/nt/ufmt/v0"
)

const (
	// maxTitleBytes matches the spec's ui.title_max_utf8_bytes.
	maxTitleBytes = 256
	// pageSize matches the spec's ui.page_size for the home listing.
	pageSize = 20
	// minimumContributionUgnot matches the spec's rules.minimum_contribution_ugnot.
	minimumContributionUgnot int64 = 1
	// denom is the only accepted native denomination (spec currency.denom).
	denom = "ugnot"
	// maxDeadlineSecondsFromNow bounds how far in the future a campaign
	// deadline may be set (see CreateCampaign). This exists specifically to
	// catch the plausible mistake of passing milliseconds where whole
	// seconds are expected: a millisecond timestamp is ~1000x a second
	// timestamp, so even a short 30-day campaign becomes roughly 82 years
	// out, and a 1-year campaign becomes roughly 1000 years out. Once
	// accepted, the mistake is unrecoverable -- a deadline this far out
	// never passes, so contributors can never be refunded and the creator
	// can never withdraw either. Ten years comfortably exceeds any
	// realistic V0 campaign length while still rejecting that entire class
	// of typo by a wide margin.
	maxDeadlineSecondsFromNow int64 = 10 * 365 * 24 * 60 * 60
	// campaignKeyWidth zero-pads campaign keys (see campaignKey) so the
	// avl.Tree's lexicographic key ordering matches numeric id ordering.
	// 19 digits covers every positive int64 (max 9223372036854775807).
	campaignKeyWidth = 19
)

var (
	campaigns      avl.Tree // campaignKey(id) -> *Campaign
	nextCampaignID int64
)

// campaignKey renders a campaign id as a fixed-width, zero-padded decimal
// string so avl.Tree's lexicographic key order matches numeric id order. An
// unpadded strconv.FormatInt key sorts "10" before "2", which silently
// breaks both direct id lookups' consistency with the tree's own ordering
// and the home listing's newest-first ordering past the ninth campaign.
func campaignKey(id int64) string {
	s := strconv.FormatInt(id, 10)
	for len(s) < campaignKeyWidth {
		s = "0" + s
	}
	return s
}

// sanitizeInline conservatively escapes untrusted, user-supplied text (only
// campaign titles in this realm) before it is stored, so every present and
// future render path (the home listing, a campaign's String() detail view,
// and any future Render addition) reads already-clean state instead of
// needing to remember to sanitize at each render site.
//
// A raw title reaching a render path unescaped can forge the surrounding
// structure it's spliced into: an embedded newline can start a fake
// "- creator: g1..." line in the listing or in a campaign's own detail view,
// and an unescaped "](" can close a markdown link label early and open a
// javascript: destination. Everything this function emits is a named or
// numeric XML/HTML character reference, safe as gnoweb markdown text.
func sanitizeInline(s string) string {
	if len(s) > maxTitleBytes {
		s = s[:maxTitleBytes]
	}
	var b strings.Builder
	for _, r := range s {
		switch r {
		case '&':
			b.WriteString("&amp;")
		case '<':
			b.WriteString("&lt;")
		case '>':
			b.WriteString("&gt;")
		case '"':
			b.WriteString("&quot;")
		case '\'':
			b.WriteString("&#39;")
		case '(':
			b.WriteString("&#40;")
		case ')':
			b.WriteString("&#41;")
		case '[':
			b.WriteString("&#91;")
		case ']':
			b.WriteString("&#93;")
		case '|':
			b.WriteString("&#124;")
		case '\n', '\r', '\t':
			b.WriteRune(' ')
		default:
			if r < 0x20 {
				continue // drop other control characters outright
			}
			b.WriteRune(r)
		}
	}
	return b.String()
}

// CreateCampaign registers a new campaign with a funding target (in ugnot)
// and a UTC unix deadline. It does not receive funds; sends_native_value is
// false for this action per the spec, so no OriginSend guard applies here.
func CreateCampaign(cur realm, title string, targetUgnot int64, deadlineUnix int64) int64 {
	creator := cur.Previous().Address()

	if len(title) == 0 {
		panic("title must not be empty")
	}
	if len(title) > maxTitleBytes {
		panic("title exceeds max size")
	}
	if !utf8.ValidString(title) {
		panic("title must be valid utf-8")
	}
	if targetUgnot <= 0 {
		panic("target must be positive")
	}
	if deadlineUnix <= time.Now().Unix() {
		panic("deadline must be in the future")
	}
	if deadlineUnix > time.Now().Unix()+maxDeadlineSecondsFromNow {
		panic("deadline too far in the future")
	}

	nextCampaignID++
	id := nextCampaignID
	campaign := &Campaign{
		id:           id,
		creator:      creator,
		title:        sanitizeInline(title),
		targetUgnot:  targetUgnot,
		deadlineUnix: deadlineUnix,
	}
	campaigns.Set(campaignKey(id), campaign)
	return id
}

// Contribute sends native ugnot to a campaign before its deadline.
//
// It must be called directly by a user account (maketx call): unsafe.OriginSend()
// only describes a real receipt at this realm when the caller is a pure user
// account. An intermediate code realm or a `maketx run` ephemeral realm can
// attach -send to a transaction but spend the envelope elsewhere, leaving
// OriginSend() reporting a phantom payment that would let a caller book a
// contribution never made and later drain the realm's real balance on
// Withdraw/Refund. This guard is the load-bearing line of the whole realm.
func Contribute(cur realm, campaignID int64) {
	if !cur.Previous().IsUserCall() {
		panic("only user-call (maketx call) accepted")
	}
	contributor := cur.Previous().Address()
	campaign := mustGetCampaign(campaignID)

	if time.Now().Unix() >= campaign.deadlineUnix {
		panic("campaign deadline has passed")
	}

	sent := unsafe.OriginSend()
	if len(sent) == 0 {
		panic("no coins sent")
	}
	if len(sent) != 1 || sent[0].Denom != denom {
		panic("only ugnot contributions are accepted")
	}
	amount := sent[0].Amount
	if amount < minimumContributionUgnot {
		panic("contribution below minimum")
	}

	key := string(contributor)
	var prev int64
	if v := campaign.contributions.Get(key); v != nil {
		prev = v.(int64)
	}
	if prev > maxInt64-amount {
		panic("contribution would overflow")
	}
	if campaign.totalRaised > maxInt64-amount {
		panic("campaign total would overflow")
	}

	campaign.contributions.Set(key, prev+amount)
	campaign.totalRaised += amount
}

// Withdraw pays a campaign's full raised balance to its creator, once, and
// only once the deadline has passed with the target reached.
//
// totalRaised is never mutated by Withdraw or Refund: it is the permanent
// gross-contributions figure (spec: success_basis gross_accepted_contributions),
// fixed the moment the deadline passes, since Contribute rejects any call
// once the deadline has passed. Withdraw and Refund are mutually exclusive
// because they read that same fixed field with complementary conditions
// (>= target vs < target), so neither action's own bookkeeping can ever
// flip the campaign's success/failure outcome and let the other action fire
// afterward.
func Withdraw(cur realm, campaignID int64) {
	caller := cur.Previous().Address()
	campaign := mustGetCampaign(campaignID)

	if campaign.withdrawn {
		panic("campaign funds already withdrawn")
	}
	if caller != campaign.creator {
		panic("only the campaign creator can withdraw")
	}
	if time.Now().Unix() < campaign.deadlineUnix {
		panic("campaign deadline has not passed")
	}
	if campaign.totalRaised < campaign.targetUgnot {
		panic("campaign did not reach its target")
	}

	// Zero (flip) the withdrawn flag before transferring so a re-entrant
	// or repeated call cannot double-spend the creator payout.
	amount := campaign.totalRaised
	campaign.withdrawn = true

	banker_ := banker.NewBanker(banker.BankerTypeRealmSend, cur)
	pkgAddr := cur.Address()
	banker_.SendCoins(pkgAddr, campaign.creator, chain.NewCoins(chain.NewCoin(denom, amount)))
}

// Refund returns a caller's own cumulative contribution, once, and only
// once the deadline has passed with the target not reached. See Withdraw
// for why the two are mutually exclusive. There is no address parameter:
// entitlement comes only from the authenticated caller's own ledger entry
// (permission: own_contribution), never from an argument a caller supplies.
func Refund(cur realm, campaignID int64) {
	caller := cur.Previous().Address()
	campaign := mustGetCampaign(campaignID)

	key := string(caller)
	v := campaign.contributions.Get(key)
	if v == nil {
		panic("no contribution found for caller")
	}
	amount := v.(int64)
	if amount <= 0 {
		panic("no contribution found for caller")
	}
	if time.Now().Unix() < campaign.deadlineUnix {
		panic("campaign deadline has not passed")
	}
	if campaign.totalRaised >= campaign.targetUgnot {
		panic("campaign succeeded; refunds are not available")
	}

	// Zero this contributor's ledger entry before transferring so a
	// re-entrant or repeated call cannot double-spend their refund.
	// totalRaised is deliberately left untouched (see Withdraw).
	campaign.contributions.Set(key, int64(0))

	banker_ := banker.NewBanker(banker.BankerTypeRealmSend, cur)
	pkgAddr := cur.Address()
	banker_.SendCoins(pkgAddr, caller, chain.NewCoins(chain.NewCoin(denom, amount)))
}

// ViewCampaign is the dedicated public read entrypoint for a single
// campaign, matching the spec's ViewCampaign action (permission: public).
// It is not a crossing function: it needs no caller identity and mutates
// no state, same as Render's per-id branch, which returns the identical
// detail view.
func ViewCampaign(campaignID int64) string {
	return mustGetCampaign(campaignID).String()
}

// Render returns a campaign list at the root path, and a single campaign's
// detail view at a sub-path holding its id.
func Render(path string) string {
	if path == "" {
		return renderHome()
	}
	id, err := strconv.ParseInt(path, 10, 64)
	if err != nil {
		return "404"
	}
	v := campaigns.Get(campaignKey(id))
	if v == nil {
		return "404"
	}
	return v.(*Campaign).String()
}

// renderHome lists the pageSize most recently created campaigns, newest
// first. ReverseIterateByOffset walks the avl.Tree largest-key-first, so an
// offset of 0 is what actually means "start from the newest": a nonzero
// offset here would skip that many of the newest entries instead, which is
// never what a "recent campaigns" listing wants.
func renderHome() string {
	output := "# Community Crowdfunding" + "\n\n"
	size := campaigns.Size()
	if size == 0 {
		return output + "No campaigns yet.\n"
	}
	campaigns.ReverseIterateByOffset(0, pageSize, func(key string, value any) bool {
		c := value.(*Campaign)
		output += ufmt.Sprintf("- %d: %s - target %dugnot raised %dugnot - %s\n",
			c.id, c.title, c.targetUgnot, c.totalRaised, c.status())
		return false
	})
	return output
}

func mustGetCampaign(campaignID int64) *Campaign {
	v := campaigns.Get(campaignKey(campaignID))
	if v == nil {
		panic("unknown campaign id")
	}
	return v.(*Campaign)
}
