// Package bounty implements the V0 supported bounty realm: a poster
// escrows a native ugnot reward for a task; workers submit work; the poster
// discretionarily approves one worker's submission to release the reward; if
// the deadline passes with no release, the poster reclaims the escrow.
// 
// A poster escrows a native GNOT reward for a task; workers submit work; the poster discretionarily approves one worker's submission to release the reward; if the deadline passes with no approval, the poster reclaims the escrow.
// 
// Generated by generator/ from the "Community Bounty" app-spec (schema_version 1.0, revision 1). Do not hand-edit generated output; change the spec and regenerate instead.
package bounty

import (
	"chain"
	"chain/banker"
	"chain/runtime/unsafe"
	"strconv"
	"strings"
	"time"
	"unicode/utf8"

	"gno.land/p/nt/avl/v0"
	"gno.land/p/nt/ufmt/v0"
)

const (
	// maxTitleBytes matches the spec's ui.title_max_utf8_bytes.
	maxTitleBytes = 256
	// maxNoteBytes bounds a SubmitWork note. The bounty family's schema has
	// no dedicated field for this (unlike crowdfunding's updates block, a
	// feature this family does not have); this is a generator-chosen
	// bound, not read from any spec field.
	maxNoteBytes = 2000
	// pageSize matches the spec's ui.page_size for the home listing.
	pageSize = 20
	// minimumRewardUgnot matches the spec's rules.minimum_reward_ugnot.
	minimumRewardUgnot int64 = 1000000
	// denom is the only accepted native denomination (spec currency.denom).
	denom = "ugnot"
	// maxDeadlineSecondsFromNow bounds how far in the future a bounty
	// deadline may be set (see CreateBounty), the same constant and
	// rationale as crowdfunding's identical bound: it catches a plausible
	// milliseconds-for-seconds typo before it puts the escrowed reward
	// out of REFUND_ONLY_AFTER_DEADLINE's reach for any realistic V0
	// bounty lifetime.
	maxDeadlineSecondsFromNow int64 = 10 * 365 * 24 * 60 * 60
	// bountyKeyWidth zero-pads bounty keys (see bountyKey) so the
	// avl.Tree's lexicographic key ordering matches numeric id ordering,
	// and so submissionKey's concatenation of a bountyKey with an address
	// is unambiguous [BOUNTY_ISOLATION]. 19 digits covers every positive
	// int64 (max 9223372036854775807).
	bountyKeyWidth = 19
)

var (
	bounties     avl.Tree // bountyKey(id) -> *Bounty
	submissions  avl.Tree // submissionKey(bountyID, worker) -> *Submission
	nextBountyID int64
)

// bountyKey renders a bounty id as a fixed-width, zero-padded decimal
// string, the same technique and rationale as crowdfunding's campaignKey.
func bountyKey(id int64) string {
	s := strconv.FormatInt(id, 10)
	for len(s) < bountyKeyWidth {
		s = "0" + s
	}
	return s
}

// submissionKey composes a fixed-width bountyKey with the worker's address
// into one flat lookup key for the package-level `submissions` tree.
// bountyKey's fixed width means this concatenation cannot be ambiguous
// between two different (bountyID, worker) pairs [BOUNTY_ISOLATION]: no
// separator is needed after a numeric prefix of guaranteed length.
func submissionKey(bountyID int64, worker address) string {
	return bountyKey(bountyID) + string(worker)
}

// sanitizeInline conservatively escapes untrusted, user-supplied text
// (bounty titles and submission notes) before it is stored, so every
// present and future render path reads already-clean state instead of
// needing to remember to sanitize at each render site. Identical escaping
// and rationale to crowdfunding's sanitizeInline (generator/lib/templates.py
// / gno/r/crowdfunding/sanitize.gno): an embedded newline can forge a fake
// "- poster: g1..." line, and an unescaped "](" can close a markdown link
// label early and open a javascript: destination.
func sanitizeInline(s string) string {
	if len(s) > maxTitleBytes {
		s = s[:maxTitleBytes]
	}
	var b strings.Builder
	for _, r := range s {
		switch r {
		case '&':
			b.WriteString("&amp;")
		case '<':
			b.WriteString("&lt;")
		case '>':
			b.WriteString("&gt;")
		case '"':
			b.WriteString("&quot;")
		case '\'':
			b.WriteString("&#39;")
		case '(':
			b.WriteString("&#40;")
		case ')':
			b.WriteString("&#41;")
		case '[':
			b.WriteString("&#91;")
		case ']':
			b.WriteString("&#93;")
		case '|':
			b.WriteString("&#124;")
		case '\n', '\r', '\t':
			b.WriteRune(' ')
		default:
			if r < 0x20 {
				continue // drop other control characters outright
			}
			b.WriteRune(r)
		}
	}
	return b.String()
}

// CreateBounty registers a new bounty and escrows its reward (in ugnot) in
// the same call, atomically.
//
// It must be called directly by a user account (maketx call): the same
// guard and reasoning as crowdfunding's Contribute. unsafe.OriginSend()
// only describes a real receipt at this realm when the caller is a pure
// user account; an intermediate code realm or an ephemeral `maketx run`
// realm can attach -send to the outer transaction while spending the coins
// elsewhere, leaving OriginSend() report a payment this realm never
// actually received [AUTHENTICATED_ACTOR].
func CreateBounty(cur realm, title string, rewardUgnot int64, deadlineUnix int64) int64 {
	if !cur.Previous().IsUserCall() {
		panic("only user-call (maketx call) accepted")
	}
	poster := cur.Previous().Address() // AUTHENTICATED_ACTOR: identity from cur, never an argument

	if len(title) == 0 {
		panic("title must not be empty")
	}
	if len(title) > maxTitleBytes {
		panic("title exceeds max size")
	}
	if !utf8.ValidString(title) {
		panic("title must be valid utf-8")
	}
	// A separate `rewardUgnot <= 0` guard would be unreachable dead code:
	// validation.py's semantic check guarantees minimumRewardUgnot >= 1, so
	// any non-positive rewardUgnot is already < minimumRewardUgnot and this
	// single guard catches it (the same one-guard pattern as Contribute's
	// `amount < minimumContributionUgnot` in crowdfunding).
	if rewardUgnot < minimumRewardUgnot {
		panic("reward below minimum")
	}
	if deadlineUnix <= time.Now().Unix() {
		panic("deadline must be in the future")
	}
	if deadlineUnix > time.Now().Unix()+maxDeadlineSecondsFromNow {
		panic("deadline too far in the future")
	}

	sent := unsafe.OriginSend()
	if len(sent) == 0 {
		panic("no coins sent")
	}
	// NATIVE_DENOM_ONLY: attack if absent -- a crafted send in a
	// non-ugnot denom is accepted as if it funded this bounty's escrow.
	if len(sent) != 1 || sent[0].Denom != denom {
		panic("only ugnot escrow is accepted")
	}
	// The attached amount must exactly match the declared rewardUgnot
	// term: rewardUgnot is one of rules.immutable_fields and is what
	// Approve/Refund will later pay out verbatim, so a mismatch here would
	// let a bounty's recorded terms disagree with what it actually holds
	// in escrow [PER_BOUNTY_CONSERVATION, CHECKED_INTEGER_MONEY].
	if sent[0].Amount != rewardUgnot {
		panic("attached funds must exactly match rewardUgnot")
	}

	nextBountyID++
	id := nextBountyID
	bounty := &Bounty{
		id:           id,
		poster:       poster,
		title:        sanitizeInline(title),
		rewardUgnot:  rewardUgnot,
		deadlineUnix: deadlineUnix,
	}
	bounties.Set(bountyKey(id), bounty)
	return id
}

// SubmitWork registers (or replaces) the caller's own submission against an
// existing bounty. It does not receive funds; sends_native_value is false
// for this action, so no OriginSend guard applies here.
//
// SubmitWork is deliberately not deadline-gated (see
// schemas/app-spec.schema.json, the bounty.invariants block description):
// release is a discretionary poster act via Approve, not an automatic
// consequence of reaching a deadline, so gating submissions alone would
// misrepresent a family whose defining property is discretionary, not
// automatic, release.
func SubmitWork(cur realm, bountyID int64, note string) {
	worker := cur.Previous().Address() // AUTHENTICATED_ACTOR: identity from cur, never an argument
	bounty := mustGetBounty(bountyID)  // BOUNTY_ISOLATION: refuse an unknown bountyID outright

	if len(note) > maxNoteBytes {
		panic("note exceeds max size")
	}
	if !utf8.ValidString(note) {
		panic("note must be valid utf-8")
	}

	key := submissionKey(bountyID, worker)
	if submissions.Get(key) == nil {
		bounty.submissionCount++
	}
	submissions.Set(key, &Submission{
		bountyID: bountyID,
		worker:   worker,
		note:     sanitizeInline(note),
	})
}

// Approve releases bountyID's escrowed reward to workerAddress, once, and
// only to an address that actually called SubmitWork for this bounty.
//
// released is set before the SendCoins transfer, the same ordering and
// reasoning as crowdfunding's Withdraw: a failed SendCoins panics and
// reverts the whole transaction atomically, including this flag flip, so a
// later retry starts from released == false again, while a re-entrant or
// repeated call instead sees released already true and refuses
// [FAILED_TRANSFER_ATOMIC, SINGLE_RELEASE_EVER].
func Approve(cur realm, bountyID int64, workerAddress address) {
	caller := cur.Previous().Address() // AUTHENTICATED_ACTOR
	bounty := mustGetBounty(bountyID)

	if caller != bounty.poster {
		panic("only the bounty poster can approve") // POSTER_ONLY_APPROVAL
	}
	if bounty.released {
		panic("bounty reward already released") // SINGLE_RELEASE_EVER
	}
	if bounty.refunded {
		panic("bounty reward already refunded") // SINGLE_RELEASE_EVER
	}
	if submissions.Get(submissionKey(bountyID, workerAddress)) == nil {
		panic("worker has no submission for this bounty") // APPROVAL_ONLY_TO_SUBMITTER
	}

	// amount comes from the bounty's own fixed, immutable term, never from
	// this realm's bank balance, so a bare unsolicited transfer to the
	// realm cannot inflate any bounty's payout [SURPLUS_NOT_CREDITED].
	amount := bounty.rewardUgnot
	bounty.released = true
	bounty.releasedTo = workerAddress

	banker_ := banker.NewBanker(banker.BankerTypeRealmSend, cur)
	pkgAddr := cur.Address()
	banker_.SendCoins(pkgAddr, workerAddress, chain.NewCoins(chain.NewCoin(denom, amount)))
}

// Refund returns bountyID's escrowed reward to its own poster, once, and
// only once the deadline has passed with the reward never released. See
// Approve for why released/refunded are mutually exclusive and why the
// flag is set before SendCoins.
func Refund(cur realm, bountyID int64) {
	caller := cur.Previous().Address() // AUTHENTICATED_ACTOR
	bounty := mustGetBounty(bountyID)

	if caller != bounty.poster {
		panic("only the bounty poster can refund") // POSTER_ONLY_REFUND
	}
	if time.Now().Unix() < bounty.deadlineUnix {
		panic("bounty deadline has not passed") // REFUND_ONLY_AFTER_DEADLINE
	}
	if bounty.released {
		panic("bounty reward already released") // SINGLE_RELEASE_EVER
	}
	if bounty.refunded {
		panic("bounty reward already refunded") // SINGLE_RELEASE_EVER
	}

	amount := bounty.rewardUgnot // SURPLUS_NOT_CREDITED: fixed term, never bank balance
	bounty.refunded = true

	banker_ := banker.NewBanker(banker.BankerTypeRealmSend, cur)
	pkgAddr := cur.Address()
	banker_.SendCoins(pkgAddr, bounty.poster, chain.NewCoins(chain.NewCoin(denom, amount)))
}

// ViewBounty is the dedicated public read entrypoint for a single bounty,
// mirroring crowdfunding's ViewCampaign. Not a crossing function: it needs
// no caller identity and mutates no state, same as Render's per-id branch,
// which returns the identical detail view.
func ViewBounty(bountyID int64) string {
	return mustGetBounty(bountyID).String()
}

// Render returns a bounty list at the root path, and a single bounty's
// detail view at a sub-path holding its id.
func Render(path string) string {
	if path == "" {
		return renderHome()
	}
	id, err := strconv.ParseInt(path, 10, 64)
	if err != nil {
		return "404"
	}
	v := bounties.Get(bountyKey(id))
	if v == nil {
		return "404"
	}
	return v.(*Bounty).String()
}

// renderHome lists the pageSize most recently created bounties, newest
// first, the same ReverseIterateByOffset(0, ...) technique and rationale as
// crowdfunding's renderHome.
func renderHome() string {
	output := "# Community Bounty" + "\n\n"
	size := bounties.Size()
	if size == 0 {
		return output + "No bounties yet.\n"
	}
	bounties.ReverseIterateByOffset(0, pageSize, func(key string, value any) bool {
		b := value.(*Bounty)
		output += ufmt.Sprintf("- %d: %s - reward %dugnot - %s\n",
			b.id, b.title, b.rewardUgnot, b.status())
		return false
	})
	return output
}

func mustGetBounty(bountyID int64) *Bounty {
	v := bounties.Get(bountyKey(bountyID))
	if v == nil {
		panic("unknown bounty id")
	}
	return v.(*Bounty)
}
