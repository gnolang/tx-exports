{"tx":{"msg":[{"@type":"/vm.m_addpkg","creator":"g16m0r7rm7fv5hx0ekr7gvx8g4fr7eu08nzhk6gt","package":{"name":"fixedpoint","path":"gno.land/p/g16m0r7rm7fv5hx0ekr7gvx8g4fr7eu08nzhk6gt/fixedpoint","files":[{"name":"fixedpoint.gno","body":"package fixedpoint\n\nconst Scale = int64(1000000)\n\ntype Fixed struct {\n\tRaw int64\n}\n\nfunc New(whole, frac int64) Fixed {\n\treturn Fixed{Raw: whole*Scale + frac}\n}\n\nfunc FromInt(i int64) Fixed {\n\treturn Fixed{Raw: i * Scale}\n}\n\nfunc (f Fixed) Add(other Fixed) Fixed {\n\treturn Fixed{Raw: f.Raw + other.Raw}\n}\n\nfunc (f Fixed) Sub(other Fixed) Fixed {\n\treturn Fixed{Raw: f.Raw - other.Raw}\n}\n\nfunc (f Fixed) Mul(other Fixed) Fixed {\n\treturn Fixed{Raw: (f.Raw * other.Raw) / Scale}\n}\n\nfunc (f Fixed) Div(other Fixed) Fixed {\n\tif other.Raw == 0 {\n\t\tpanic(\"fixedpoint: division by zero\")\n\t}\n\treturn Fixed{Raw: (f.Raw * Scale) / other.Raw}\n}\n\nfunc (f Fixed) String() string {\n\twhole := f.Raw / Scale\n\tfrac := f.Raw % Scale\n\tif frac \u003c 0 {\n\t\tfrac = -frac\n\t}\n\tfracStr := itoa(frac)\n\tfor len(fracStr) \u003c 6 {\n\t\tfracStr = \"0\" + fracStr\n\t}\n\treturn itoa(whole) + \".\" + fracStr\n}\n\nfunc itoa(n int64) string {\n\tif n == 0 {\n\t\treturn \"0\"\n\t}\n\tneg := n \u003c 0\n\tif neg {\n\t\tn = -n\n\t}\n\tvar buf [20]byte\n\ti := len(buf)\n\tfor n \u003e 0 {\n\t\ti--\n\t\tbuf[i] = byte('0' + n%10)\n\t\tn /= 10\n\t}\n\ts := string(buf[i:])\n\tif neg {\n\t\ts = \"-\" + s\n\t}\n\treturn s\n}\n"},{"name":"gnomod.toml","body":"module = \"gno.land/p/g16m0r7rm7fv5hx0ekr7gvx8g4fr7eu08nzhk6gt/fixedpoint\"\ngno = \"0.9\"\n"}],"type":{"@type":"/gno.MemPackageType","value":"MPUserAll"}},"send":"","max_deposit":""}],"fee":{"gas_wanted":"50000000","gas_fee":"1000000ugnot"},"signatures":[{"pub_key":{"@type":"/tm.PubKeySecp256k1","value":"AjNM8kyoIRAgmj227lxB4Fi4oYKxJ810GIcAFIIqDb28"},"signature":"igZC3CGiqzXi5O+MVzMZPpPDGLbJXzSYB7x6iNwbmPwOhmi2ge4X9cbBYb6tmkCTX9gUhMSEmZfIYtLCKlcjHA=="}],"memo":""},"metad