{"tx":{"msg":[{"@type":"/vm.m_addpkg","creator":"g17qqz5nhc99390qanhl7nxq9c2augjjadh0k65h","package":{"name":"patusfenixv2","path":"gno.land/r/g17qqz5nhc99390qanhl7nxq9c2augjjadh0k65h/patusfenixv2","files":[{"name":"gnomod.toml","body":"module = \"gno.land/r/g17qqz5nhc99390qanhl7nxq9c2augjjadh0k65h/patusfenixv2\"\ngno = \"0.9\"\n"},{"name":"patus_fenix.gno","body":"\npackage patusfenixv2\n\nimport (\n    \n    \"gno.land/p/nt/grc721/v0\"\n    \"gno.land/p/nt/grc721/metadata/v0\"\n)\n\nconst metadataURL = \"https://patusworld.com/patus-testnet/1.json\"\n\nvar (\n    collection *grc721.Token\n    ledger     *grc721.PrivateLedger\n    nftMeta    *metadata.Metadata\n    metaLedger *metadata.Ledger\n)\n\nfunc init(cur realm) {\n    collection, ledger = grc721.NewToken(\n        \"Patus Fenix Test\",\n        \"PFT\",\n        0,\n        cur,\n    )\n\n    nftMeta, metaLedger = metadata.NewMetadata(ledger)\n}\n\n// MintTest acuna un unico NFT de prueba.\n// La wallet que ejecuta la funcion recibe el NFT.\nfunc MintTest(cur realm) string {\n    if collection.TotalSupply() \u003e= 1 {\n        return \"Patus Fenix has already been minted\"\n    }\n\n    owner := cur.Previous().Address()\n\n    if err := ledger.Mint(owner, \"1\"); err != nil {\n        return err.Error()\n    }\n\n    if err := metaLedger.SetTokenURI(\"1\", metadataURL); err != nil {\n        return err.Error()\n    }\n\n    return \"Patus Fenix minted successfully\"\n}\n\n// Permite consultar la URL de metadatos del NFT.\nfunc TokenURI(tokenID string) string {\n    uri, err := nftMeta.TokenURI(grc721.TokenID(tokenID))\n    if err != nil {\n        return \"\"\n    }\n    return uri\n}\n\n// Permite consultar cuantos NFT existen.\nfunc TotalSupply() int64 {\n    return collection.TotalSupply()\n}\n\n// Pagina informativa del contrato.\nfunc Render(path string) string {\n    return \"Patus Fenix - GRC721 Test NFT on Onyx\"\n}\n\n// Devuelve la direccion propietaria del NFT.\nfunc OwnerOf() string {\n    owner, err := collection.OwnerOf(\"1\")\n    if err != nil {\n        return \"\"\n    }\n    return owner.String()\n}"},{"name":"patus_fenix_test.gno","body":"\npackage patusfenixv2\n\nimport (\n    \"testing\"\n\n    \"gno.land/p/nt/testutils/v0\"\n    \"gno.land/p/nt/urequire/v0\"\n)\n\nfunc TestPatusFenixMint(cur realm, t *testing.T) {\n    // Verificar que inicialmente no hay NFTs.\n    urequire.Equal(t, int64(0), TotalSupply())\n\n    // Simular la llamada desde una wallet de prueba.\n    alice := testutils.TestAddress(\"alice\")\n\n    result := func() string {\n        return MintTest(cross(cur))\n    }()\n\n    urequire.Equal(t, \"Patus Fenix minted successfully\", result)\n\n    // Comprobar que existe exactamente un NFT.\n    urequire.Equal(t, int64(1), TotalSupply())\n\n    // Comprobar que el NFT tiene un propietario.\nowner := OwnerOf()\nurequire.True(t, owner != \"\")\nurequire.True(t, owner != \"g1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqd8f3t\")\n\n    // Comprobar la URL de los metadatos.\n    urequire.Equal(\n        t,\n        \"https://patusworld.com/patus-testnet/1.json\",\n        TokenURI(\"1\"),\n    )\n\n    // Un segundo mint no debe crear otro NFT.\n    second := MintTest(cross(cur))\n    urequire.Equal(t, \"Patus Fenix has already been minted\", second)\n    urequire.Equal(t, int64(1), TotalSupply())\n\n    // Verificar que la dirección de prueba es válida.\n    urequire.True(t, alice.IsValid())\n}\n"}],"type":{"@type":"/gno.MemPackageType","value":"MPUserAll"}},"send":"","max_deposit":""}],"fee":{"gas_wanted":"8000000","gas_fee":"10000ugnot"},"signatures":[{"pub_key":{"@type":"/tm.PubKeySecp256k1","value":"ArbN4/2cMQMyNpjHKbYWWHG/Puxa4ElkrvQnqr6r2uYp"},"signature":"BJH/77AHy5fFzunFd6N1c890bcGFTO+lTQQzR/LGUHwxGFxznRyVcJz/bMm7TTlXHwnQqrp/GNa83iXa+JCg8g=="}],"memo":""},"metadata":{"timestamp":"1795303677"}}
