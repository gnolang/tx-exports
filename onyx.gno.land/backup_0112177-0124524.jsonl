{"tx":{"msg":[{"@type":"/vm.m_addpkg","creator":"g1sl6fyq6mrc3wydt8xluhxx4aqsudpp9vhv6g2a","package":{"name":"gnotif","path":"gno.land/r/g1sl6fyq6mrc3wydt8xluhxx4aqsudpp9vhv6g2a/gnotif","files":[{"name":"gnomod.toml","body":"module = \"gno.land/r/g1sl6fyq6mrc3wydt8xluhxx4aqsudpp9vhv6g2a/gnotif\"\ngno = \"0.9\"\n"},{"name":"gnotif.gno","body":"// Package gnotif is a registry of notification triggers. Each trigger names\n// a realm and an event type to watch, and the text of the notification that\n// gnotif servers send when a matching event lands on chain.\npackage gnotif\n\nimport (\n\t\"chain\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"gno.land/p/nt/avl/v0\"\n\t\"gno.land/p/nt/seqid/v0\"\n)\n\n// Trigger is one declared notification rule. Filter holds comma-separated\n// key=value pairs; Title, Body and Link are templates where {key} stands for\n// the value of the event's attribute key.\ntype Trigger struct {\n\tID, Target, Event, Filter, Param, Title, Body, Link string\n\tDeclarer address\n\tVerified bool\n}\n\nconst (\n\ttargetPrefix   = \"gno.land/r/\"\n\tmaxTarget      = 256\n\tmaxName        = 64\n\tmaxFilterPairs = 8\n\tmaxBody        = 255\n\tmaxLink        = 256\n)\n\nvar (\n\ttriggers avl.Tree // id → *Trigger\n\tlastID   seqid.ID\n)\n\n// Declare stores a trigger and returns its id. The trigger is verified when\n// its caller is the target realm itself.\nfunc Declare(cur realm, target, event, filter, param, title, body, link string) string {\n\tvalidate(target, event, filter, param, title, body, link)\n\tcaller := cur.Previous()\n\ttr := \u0026Trigger{\n\t\tID:       lastID.Next().String(),\n\t\tTarget:   target,\n\t\tEvent:    event,\n\t\tFilter:   filter,\n\t\tParam:    param,\n\t\tTitle:    title,\n\t\tBody:     body,\n\t\tLink:     link,\n\t\tDeclarer: caller.Address(),\n\t\tVerified: caller.IsCode() \u0026\u0026 caller.PkgPath() == target,\n\t}\n\ttriggers.Set(tr.ID, tr)\n\tchain.Emit(\"TriggerDeclared\",\n\t\t\"id\", tr.ID,\n\t\t\"target\", tr.Target,\n\t\t\"event\", tr.Event,\n\t\t\"filter\", tr.Filter,\n\t\t\"param\", tr.Param,\n\t\t\"title\", tr.Title,\n\t\t\"body\", tr.Body,\n\t\t\"link\", tr.Link,\n\t\t\"declarer\", tr.Declarer.String(),\n\t\t\"verified\", strconv.FormatBool(tr.Verified),\n\t)\n\treturn tr.ID\n}\n\n// Remove deletes a trigger. Only its declarer may remove it.\nfunc Remove(cur realm, id string) {\n\tv := triggers.Get(id)\n\tif v == nil {\n\t\tpanic(\"unknown trigger\")\n\t}\n\tif v.(*Trigger).Declarer != cur.Previous().Address() {\n\t\tpanic(\"not the declarer\")\n\t}\n\ttriggers.Remove(id)\n\tchain.Emit(\"TriggerRemoved\", \"id\", id)\n}\n\nfunc validate(target, event, filter, param, title, body, link string) {\n\tswitch {\n\tcase !strings.HasPrefix(target, targetPrefix) || len(target) \u003e maxTarget:\n\t\tpanic(\"invalid target\")\n\tcase !sized(event, 1, maxName):\n\t\tpanic(\"invalid event\")\n\tcase !validFilter(filter):\n\t\tpanic(\"invalid filter\")\n\tcase !sized(param, 0, maxName):\n\t\tpanic(\"invalid param\")\n\tcase !sized(title, 1, maxName):\n\t\tpanic(\"invalid title\")\n\tcase !sized(body, 0, maxBody):\n\t\tpanic(\"invalid body\")\n\tcase !validLink(link):\n\t\tpanic(\"invalid link\")\n\t}\n}\n\nfunc sized(s string, lo, hi int) bool {\n\treturn len(s) \u003e= lo \u0026\u0026 len(s) \u003c= hi\n}\n\nfunc validFilter(filter string) bool {\n\tif filter == \"\" {\n\t\treturn true\n\t}\n\tpairs := strings.Split(filter, \",\")\n\tif len(pairs) \u003e maxFilterPairs {\n\t\treturn false\n\t}\n\tfor _, pair := range pairs {\n\t\tkey, value, ok := strings.Cut(pair, \"=\")\n\t\tif !ok || !sized(key, 1, maxName) || !sized(value, 1, maxName) || strings.Contains(value, \"=\") {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\n// validLink accepts only a path, so a click always stays on the dapp's origin.\n// \"//host\" and \"/\\host\" start with a slash yet resolve to another host.\nfunc validLink(link string) bool {\n\treturn sized(link, 1, maxLink) \u0026\u0026\n\t\tstrings.HasPrefix(link, \"/\") \u0026\u0026\n\t\t!strings.HasPrefix(link, \"//\") \u0026\u0026\n\t\t!strings.HasPrefix(link, \"/\\\\\")\n}\n"},{"name":"render.gno","body":"package gnotif\n\nimport (\n\t\"strings\"\n\n\t\"gno.land/p/nt/markdown/sanitize/v0\"\n)\n\n// Render lists the triggers in declaration order.\nfunc Render(path string) string {\n\tvar b strings.Builder\n\tb.WriteString(\"# gnotif triggers\\n\\n\")\n\ttriggers.Iterate(\"\", \"\", func(_ string, v any) bool {\n\t\ttr := v.(*Trigger)\n\t\tb.WriteString(\"- **\" + tr.ID + \"** \" + sanitize.InlineText(tr.Target) + \" · \" + sanitize.InlineText(tr.Event))\n\t\tif tr.Param != \"\" {\n\t\t\tb.WriteString(\" · param \" + sanitize.InlineText(tr.Param))\n\t\t}\n\t\tif tr.Verified {\n\t\t\tb.WriteString(\" · ✓ verified\")\n\t\t}\n\t\tb.WriteString(\" · by \" + tr.Declarer.String() + \"\\n\")\n\t\treturn false\n\t})\n\treturn b.String()\n}\n"}]},"send":"","max_deposit":"10000000ugnot"}],"fee":{"gas_wanted":"11520573","gas_fee":"23042ugnot"},"signatures":[{"pub_key":{"@type":"/tm.PubKeySecp256k1","value":"AyaToBv49HsJeoDnDi2Ft51fcHhpkffNGmb0U3H4AMyp"},"signature":"5xncZkEaaC8sV1qr5ynXycLpseG8bYu26vQ4fwVmeIoENEVz0uRqsqP/dScIfdkTyjYQQRxCYAUxnwhWIfPO0Q=="}],"memo":""},"metadata":{"timestamp":"1790972900"}}
