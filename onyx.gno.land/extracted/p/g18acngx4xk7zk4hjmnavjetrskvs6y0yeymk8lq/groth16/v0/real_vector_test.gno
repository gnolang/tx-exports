// TestRealProofVerifies is the end-to-end check: a proof produced by snarkjs
// from real circom output must be accepted on chain.
func TestRealProofVerifies(t *testing.T) {
	if err := Verify(realKey(t), realProof(t), realInputs(t)); err != nil {
		t.Fatalf("circom proof rejected on chain: %v", err)
