}

// TestRealProofRejectsWrongInput pins that the public signals are bound to the
// proof: a different input must change vk_x and fail.
func TestRealProofRejectsWrongInput(t *testing.T) {
	inputs := realInputs(t)
	inputs[0][scalarSize-1]++
	if err := Verify(realKey(t), realProof(t), inputs); err != ErrInvalidProof {
		t.Fatalf("want ErrInvalidProof, got %v", err)
	}
}
