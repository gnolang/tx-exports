}

// TestProductProofRejectsWrongInput pins that the public signals are bound to the
// proof: a different input must change vk_x and fail.
func TestProductProofRejectsWrongInput(t *testing.T) {
	inputs := productInputs(t)
	inputs[0][scalarSize-1]++
	if err := Verify(productKey(t), productProof(t), inputs); err != ErrInvalidProof {
		t.Fatalf("want ErrInvalidProof, got %v", err)
	}
}
