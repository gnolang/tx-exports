package groth16

import "testing"

func TestDifferentialSnarkjsFixtures(t *testing.T) {
	vkMult := multiplierVK(t)
	vkSq := sumOfSquaresVK(t)
	{
		p, err := ParseProofHex("23eef16d7ac0137ca9a371168310e4b5c32ad022929adcbced5b36c05c1e7a7b221d28d4bca6bba575328ec24df285adaf0edc5f1b3d94805cd0bb9c72c5837b", "13a562503b504c4312109b6b1fdeef29ad7b5a2c4d92b0d7ded30554505672a500c5fb400f5c54fd628e16d4a476b6aca7af3656187d6b3583c6244cc2c103bc24530b66351b95199b2dee45af4b7aa83c40630a84a4b8caf51e4f14c5cdd0df26400b42d00b99290392f22fcbb12c506eb138260ba2cecdc3459bf37245e6e9", "2cf95d2c148d593b0dc05011cec6fe5a644a0fd0bee6d13ecadd41e7cf0569972f373d0339d50c5f41ba7968e18573cda48ed9f1595eb57b93f1eb170e4c05b6")
