package semaphore

import (
	"encoding/hex"
	"testing"

	"gno.land/p/g1c3m9uesphlhmj6fkx6nsh3fvhw8apqyjwyhe04/groth16/v2"
)

func TestHashToFieldMatchesSemaphoreSDK(t *testing.T) {
	// Exact vectors generated by @semaphore-protocol/proof@4.13.0 hash(1n) and hash(42n).
	msg1 := Uint64ToBE32(1)
	h1, err := HashToField(msg1)
	if err != nil {
		t.Fatalf("HashToField(1): %v", err)
	}
	want1 := "00b10e2d527612073b26eecdfd717e6a320cf44b4afac2b0732d9fcbe2b7fa0c"
	if got := hex.EncodeToString(h1); got != want1 {
		t.Fatalf("HashToField(1) mismatch:\n got  %s\n want %s", got, want1)
	}

	scope42 := Uint64ToBE32(42)
	h42, err := HashToField(scope42)
	if err != nil {
		t.Fatalf("HashToField(42): %v", err)
	}
	want42 := "00beced09521047d05b8960b7e7bcc1d1292cf3e4b2a6b63f48335cbde5f7545"
	if got := hex.EncodeToString(h42); got != want42 {
		t.Fatalf("HashToField(42) mismatch:\n got  %s\n want %s", got, want42)
	}
}

func TestDomainScopeSeparation(t *testing.T) {
	s1 := DomainScope("gno.land/r/veil/vote_v1", 42)
	s2 := DomainScope("gno.land/r/other/vote_v1", 42)
	if hex.EncodeToString(s1) == hex.EncodeToString(s2) {
		t.Fatalf("expected distinct domain-separated scopes for distinct apps")
	}

	f1 := DomainScopeFull("onyx-1", "veil_vote/v1", 1, 42)
	f2 := DomainScopeFull("mainnet", "veil_vote/v1", 1, 42)
	f3 := DomainScopeFull("onyx-1", "veil_vote/v1", 2, 42)
	if hex.EncodeToString(f1) == hex.EncodeToString(f2) || hex.EncodeToString(f1) == hex.EncodeToString(f3) {
		t.Fatalf("expected distinct full domain scopes across network/group")
	}
}

func TestVKRegistryImmutabilityAndGroupVersioning(t *testing.T) {
	vks := NewVKRegistry()
	gr := NewGroupRegistry()
	admin := address("g1c3m9uesphlhmj6fkx6nsh3fvhw8apqyjwyhe04")
	if err := gr.CreateGroup(1, 10, admin, admin, vks); err != ErrUnsupportedDepth {
		t.Fatalf("expected ErrUnsupportedDepth, got %v", err)
	}
	dummyVK := groth16.VerifyingKey{IC: make([][]byte, 5)}
	if err := vks.Register(10, dummyVK); err != nil {
		t.Fatalf("first Register failed: %v", err)
	}
	if err := vks.Register(10, dummyVK); err != ErrVKAlreadyRegistered {
		t.Fatalf("expected ErrVKAlreadyRegistered on duplicate register, got %v", err)
	}
}
