// Package fund is Charterbook: a demonstration investment fund whose dealing
// terms are enforced by code. The legal document of a real fund would stay
// off-chain.
//
// TEST DEPLOYMENT: fictional fund, fictional parties, test tokens without
// value. Not operated by any regulated firm. Unaudited code. Not an offer.
//
// One dealing period runs: Open (orders and compliance decisions) ->
// Cut-off -> NAV proposed by the administrator -> NAV approved by the
// independent valuation reviewer -> settlement in batches -> next period.
// Investors hold shares directly (their own wallet) or through the nominee
// sub-realm (pseudonymous sub-accounts).
package fund

import (
	"crypto/sha256"
	"encoding/hex"

	"gno.land/p/g1thug63es793ckaw63l2704qzp3a92y58kekda0/cbtrial1/fundmath"
)

const u = fundmath.Unit

// Terms of the memorandum, enforced by the code. The terms page formats
// every figure from these constants.
const (
	FundName                        = "Charterbook Demonstration Fund I"
	MemoVersion                     = "6.0"
	Lot                       int64 = 10_000 * u // subscriptions and partial redemptions
	MinHolding                int64 = 10_000 * u // below this after a redemption: full exit
	Par                       int64 = 100 * u    // price per share of the first issue
	FeeBps                    int64 = 150        // management fee, % a year of gross assets
	AdminFeeBps               int64 = 10         // administration, % a year of gross assets
	BankFeeBps                int64 = 5          // deposit bank, % a year of gross assets
	OrgCostTotal              int64 = 6_000 * u  // set-up costs advanced by the manager
	OrgCostPeriods            int64 = 60         // written off over 60 periods
	PerfFeeBps                int64 = 2_000      // performance fee, % of the gain above each investor's mark
	CrystalliseEvery          int64 = 6          // periods between performance-fee crystallisations
	DefaultCrystalliseMinDays int64 = 180        // and at least these days, unless set otherwise before launch
	PeriodSeconds             int64 = 30 * 24 * 60 * 60
	GateBps                   int64 = 1_000 // redemptions per period, % of NAV (never less than one lot)
	NoticePeriods             int64 = 0     // a request is dealt at the period it is placed in
	NAVToleranceBps           int64 = 500   // larger moves need the reviewer's acknowledgement
	OutflowCapBps             int64 = 6_500 // investment payments per period, % of last NAV
	ConcentrationBps          int64 = 6_500 // per instrument, % of last NAV
	ComplianceTimeoutPeriods  int64 = 2     // undecided subscriptions refundable after
	EligibilityMaxDays        int64 = 365
	AgentSessionMaxDays       int64 = 60
	MaxSuspensionDays         int64 = 30  // a suspension ends by itself unless renewed with two keys
	MinHoldingNoticeDays      int64 = 30  // notice before a compulsory redemption below the minimum
	AuditDueDays              int64 = 182 // audited annual report due within 6 months of year end
	MaxOpenRequests                 = 200 // open redemption requests at any time
	MaxOpenSubscriptions            = 200
)

// memorandum is the investment memorandum, on-chain. Its SHA-256 is shown on
// the portal; an amendment would be a new realm version.
var memorandum = []struct{ Title, Body string }{
	{"1. The fund", "Charterbook Demonstration Fund I is a fictional open-ended fund on the gno.land Onyx testnet. It shows how a fund's terms can be enforced by code. It holds test tokens only. A real fund's legal documents would stay off-chain; this memorandum stands in for them, and its SHA-256 is shown on the portal."},
	{"2. Dealing", "The fund deals once a month, in one dealing period. A period opens, takes orders and compliance decisions, and is cut off by the administrator; if the administrator does not, anyone may cut it off once it has run 30 days. The administrator proposes a net asset value (NAV) and the independent valuation reviewer approves it. Every order of the period is dealt at that one NAV (forward pricing), unless it is held by compliance, limited by the gate or waiting out a suspension. The orders dealt are fixed at the first settlement call. The dealing currency is Test Dollar (tUSD). In the demonstration, periods last minutes."},
	{"3. Two ways to hold shares", "Direct: the investor's own wallet is in the register. Nominee: the nominee places orders for a pseudonymous sub-account and pays the investor; no investor wallet appears in the register. Lots, the gate, fees and the performance fee apply to a sub-account as to a wallet. The nominee registers each sub-account in the fund before handing out its identifier, and the fund refuses a sub-account that already has a compliance status. The nominee's orders need the compliance officer's attestation of the period's batch; compliance decisions about a sub-account are the nominee's, kept off-chain. If the nominee is restricted, all its sub-accounts' orders are held. A realm deployed at the registered nominee path confirmed itself before launch; its code is public there."},
	{"4. Subscriptions", "Subscriptions are made in multiples of one lot of 10,000 tUSD. A direct subscriber's wallet must be found eligible by the compliance officer, who then accepts or rejects the subscription; the money waits in the fund's escrow account until it is dealt at settlement. A subscription that is not accepted is refunded in full; until it is accepted, the subscriber may cancel it. Once accepted it is irrevocable: the subscriber may ask on-chain for it to be withdrawn, and the administrator may then withdraw and refund it in that period; the subscriber may also take it back if the wallet stops being eligible. A subscription left undecided for two periods can be refunded by anyone, to the subscriber. If a period sits in cut-off or awaiting its NAV for more than 7 days, subscribers may take their money back out of escrow. The first shares are issued at 100 tUSD each. The manager may close the fund to new subscriptions and reopen it."},
	{"5. Redemptions", "There is no lock-up: shares can be redeemed from the period after they are issued. An investor may redeem in multiples of one lot, or the whole holding; a redemption that would leave less than 10,000 tUSD redeems the whole holding. A request is irrevocable: the investor may ask on-chain for it to be withdrawn, and the administrator may then withdraw it in that period. Payment goes to the same wallet, or to the nominee for a sub-account. Each period redemptions are limited to 10% of NAV, never less than one lot, and to the cash available after fees and compulsory redemptions (the gate). Requests carried from earlier periods are served first, then new requests. Within each group, requests that exceed what is left are filled pro rata in whole lots, and requests that received nothing are served first from what remains; a whole-holding redemption larger than its share is paid in whole lots while at least 10,000 tUSD stays invested. Anything unfilled stays invested and is dealt at the next period's NAV, ahead of new requests. If only one request is left unfilled and it is the rest of a whole-holding redemption below 20,000 tUSD, it is paid from cash even above the gate."},
	{"6. Valuation", "NAV is the fund's recorded cash plus the marks of its listed instruments, less the fees for the period and anything still owed. tUSD sent to the fund outside the dealing process does not change NAV until the manager proposes and the reviewer countersigns it as a receipt, which the code accepts only if the cash account holds it on top of the recorded cash and any payments set aside for restricted holders. Rounding always favours the investors who stay: shares issued round down, shares cancelled for a payment round up, and whole-holding payments round down. A NAV per share that moves by more than 5%, or any NAV after one of zero, needs the reviewer's explicit acknowledgement. Below 1 tUSD per share, or at a NAV of zero or less, no order is dealt in that period, but the period completes and the fees are charged or owed, so the board can still suspend or wind the fund down."},
	{"7. Fees and expenses", "Charged on gross assets, accrued on the time between valuations (at most 30 days per period) and paid at settlement: the management fee of 1.50% a year to the manager, the administration fee of 0.10% a year to the administrator and the deposit bank fee of 0.05% a year to the bank. The set-up costs of 6,000 tUSD, advanced by the manager, are repaid over 60 months, accrued on time like the fees (100 tUSD per 30 days). Other expenses (the audit, legal and similar costs) are proposed by the administrator and paid only when the reviewer countersigns in the same period, only from cash not owed to others, and only to a service provider listed on the terms page; a role holder may be listed only for its own fee. A fee that cash cannot cover is owed to its payee, deducted from NAV and paid first when cash allows; when the cash does not cover every payee, each is paid pro rata. At most 30 payments, receipts and expenses may be proposed in a period."},
	{"8. Performance fee", "20% of the gain above each investor's own high-water mark. The mark starts at the price an investor subscribes at; a later subscription blends it with the new price, weighted by shares. The fee is charged when shares are redeemed, by cancelling extra shares worth the fee, and paid to the manager after every redemption of the period has been paid; what cash cannot cover is owed. It is crystallised for every holder at least 6 periods and at least the number of days shown on the terms page after the last crystallisation, and in each wind-down distribution: the fund cancels shares worth the fee and the mark moves up to that period's NAV per share. Nothing is due while the NAV per share is at or below the mark, so an investor never pays twice for the same gain."},
	{"9. Investment limits", "The manager may invest only in the instruments listed on the terms page. Each investment payment needs the reviewer's countersignature in the same period, and is paid only to the instrument's listed address. Investment payments in one period may not exceed 65% of the last NAV in total, and may not raise one instrument above 65% of the last NAV. Money coming back from an instrument is recorded only with both signatures. Instruments held off-chain rest on trust in the manager and the reviewer."},
	{"10. Suspension", "The manager may propose to suspend dealing, for one of the listed reasons, for up to 30 days; it starts only when the reviewer approves in the same period. While dealing is suspended, NAVs are still calculated but no order is dealt: orders wait, and are dealt at the first NAV after the suspension. A suspension ends by itself when its time runs out; it can be renewed, or lifted early, only with both keys. Either key may drop a pending proposal."},
	{"11. Compulsory redemption", "The compliance officer may redeem a direct holding in full when the holder is no longer eligible, would put the fund in breach of law, or has not provided the information asked for; the reason stays off-chain, and only a salted commitment to the officer's record is kept. A top-up the fund can no longer deal is refunded first. For a sub-account, the nominee does this off-chain. The manager may give notice to a holder worth less than 10,000 tUSD; the notice lapses if the holding is topped up above that. If it is still below after 30 days, the manager may propose its redemption, and it happens only if the reviewer approves in the same period and the holding is still below the minimum. A compulsory redemption cannot be withdrawn. It is paid ahead of the gate: whole when cash allows, otherwise in whole lots from the cash there is, the rest at the next period."},
	{"12. Wind-down and closure", "The fund is wound down when the manager proposes it and the reviewer approves in the same period, or by itself when the last investor asks to redeem everything, even at a low NAV (a compulsory redemption does not count; a board suspension defers it). Before approval, the manager may withdraw the proposal and the reviewer may decline it. Once it is approved the fund takes no new subscriptions, redemption requests or investments; at the first settlement of that period, subscriptions in escrow are refunded (held ones stay held) and open requests are replaced by the distributions. The manager sells the investments, each sale recorded as a receipt with both signatures. Each period, all available cash is paid out pro rata to the holders, by cancelling shares at the NAV after fees and performance fee. When no investment is left, the last distribution pays every holder the full value of the shares. If nothing is left for the shareholders, every share is cancelled without payment and the cash left goes to the creditors (the fees and set-up costs owed to the manager, the administrator and the bank), pro rata to what each is owed; the rest is written off. A restricted holder's payment is set aside for that holder, out of NAV and out of the fees, and paid once the restriction is lifted; anyone may then trigger the payment. After the last distribution the fund stays in liquidation: money recorded then, such as a late recovery on a written-off note, goes first to any creditors still owed and then pro rata to the holders of that distribution, by the number of shares each had cancelled in it. The fund closes only when the manager proposes it and the reviewer approves in the same period, and only once no shares, no subscription in escrow, no set-aside payment, no instrument on the books and nothing to pay out are left; only rounding dust goes to the manager. Nothing can be recorded after closure. A wind-down cannot be reversed in this version."},
	{"13. Oracles", "An oracle here is a named account whose signed decisions the fund accepts. The compliance officer decides eligibility, subscriptions, restrictions and compulsory redemptions. The screening agent checks investors against the public sanctions lists and may only recommend: its session key is limited by the chain to this fund's realms and expires no later than the date the officer registered (the officer also sets its spend limit), and the fund's code refuses any decision from that key. The agent publishes each list snapshot it uses (list, date and SHA-256) so anyone can check it against the official file. The administrator and the reviewer together are the valuation oracle. Every decision is recorded with its signer and block height."},
	{"14. Confidentiality", "Direct holders: compliance decisions are public transactions that name the wallet; the fund stores only each wallet's latest status (eligible or not, until when, restricted or not) with a salted commitment to the off-chain record. Reasons, scores and evidence stay off-chain, including the reason for a compulsory redemption. Wallets are pseudonymous, not anonymous. Nominee holders: no investor wallet appears in the register, and the fund refuses any compliance decision naming a sub-account the nominee has registered. Deposits and payments between wallets and the nominee are public, and privacy grows with the number of investors per period. Nominee holders trust the nominee and the reviewer to pay the right wallet, as with a custodian."},
	{"15. Restrictions", "A restricted holder's orders are held: not dealt and not refunded. The orders dealt in a period are fixed when settlement starts; a restriction placed after that holds the redemption, which is carried, and freezes the shares issued, which cannot be redeemed while the restriction lasts. Held orders count towards the limit of 200 open subscriptions and 200 open redemption requests."},
	{"16. Audit", "The fund's annual report is audited. The auditor records on-chain, once for each year, the SHA-256 of the signed report. It is due within 6 months of the year end: the portal shows each year as recorded, due or overdue, up to the year the fund closes."},
	{"17. Roles and two keys", "Roles are fixed for this version: manager, administrator, valuation reviewer, compliance officer and auditor. Role addresses are refused as investors; related wallets must be declared to the compliance officer. A proposal that needs two keys, including a nominee payment, is valid only in the period it is made. The manager never moves money or assets on his signature alone: every investment payment, receipt, suspension, compulsory redemption below the minimum and wind-down he starts needs the reviewer, and expenses are proposed by the administrator, not by him. The administrator withdraws an order only after its investor has asked for it on-chain. The nominee's operator cannot hold a fund role. Outside these rules, the code moves investor money only back to its owner or as this memorandum describes."},
	{"18. Contract notes and statements", "For every issue and cancellation of shares the fund's code writes a contract note at settlement: subscription, redemption, compulsory redemption, wind-down distribution, late recovery, cancellation without payment, and performance fee crystallised. Each note shows the date, the NAV per share, the shares, the gross value, the performance fee, the net amount and the holding after; a cancellation also shows the cost of the shares at average cost and the realised gain or loss. The cost of a holding is what was subscribed; a cancellation takes off its share of that cost, and a performance fee paid by cancelling shares leaves the cost unchanged. An annual statement per holder and year lists the notes, the totals and the holding at the year end. Notes cannot be altered and carry the block height. They are for information: tax treatment depends on the investor's country."},
}

func memorandumHash() string {
	var b []byte
	for _, s := range memorandum {
		b = append(b, s.Title...)
		b = append(b, 0)
		b = append(b, s.Body...)
		b = append(b, 0)
	}
	h := sha256.Sum256(b)
	return hex.EncodeToString(h[:])
}
